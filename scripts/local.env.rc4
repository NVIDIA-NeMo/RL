# 4-NODE COLOCATED GRPO on BIRD with the release image nemo-rl-v0.8.0.rc4 (arm64) on the r0.8.0 checkout, CMH or DFW.
# The image's uv.lock / pyproject.toml / submodule pins are identical to r0.8.0 (a742a55ee): no source builds.
# The seed (CPU) builds the Gym server venvs, warms the uv cache and downloads the model; training then starts quickly.
# Switch clusters by editing CLUSTER below; everything else follows.
#
#   source scripts/local.env.rc4
#   SEED_GYM_VENVS=1 ./scripts/remote_launch_offline_rl.sh     # once: Gym server venvs (CPU only, no GPUs)
#   ./scripts/remote_launch_offline_rl.sh                      # training
#
# Setup of the remote checkout (see the notes at the bottom of this file).
# Every var here is read by scripts/remote_launch_offline_rl.sh on your Mac and forwarded over SSH to
# scripts/launch_offline_rl_slurm.sh on the login node. Never commit real values, especially WANDB_API_KEY.

# Clear settings left exported by the main-checkout env files (local.env.example etc.): the remote script forwards
# whatever is set, and none of these apply to this image.
unset UV_PYTHON_INSTALL_DIR UV_SYNC_CACHE_DIR GYM_UV_CACHE_DIR UV_VERSION UV_PYTHON_VERSION UV_PROJECT_ENVIRONMENT
unset SEED_BUILD_ENV SEED_MAX_JOBS SEED_CONCURRENT_BUILDS USE_LOCKED_DEPS_ENV PRECOMPILE_MCORE_DATASET_HELPER EXTRA_ARGS

# ---- Cluster: CMH, DFW, AGA or HSG ----
export CLUSTER=HSG
case "${CLUSTER}" in
  CMH)
    export LOGIN_HOST=dmisra@aws-cmh-slurm-1-login-01
    export SLURM_ACCOUNT=nemotron_n4_post
    export GPUS_PER_NODE=4
    export SEED_PARTITION=cpu
    export CONTAINER=/scratch/fsw/portfolios/nemotron/projects/nemotron_reason_code/users/siddjain/containers/nemo-rl-v0.8.0.rc4-arm64.sqsh
    export REMOTE_REPO_DIR=/lustre/fsw/portfolios/nemotron/users/dmisra/omega
    # HF cache (model), BIRD databases and uv cache already exist in the main-checkout dir on CMH: reuse them.
    export SHARED_DIR=/lustre/fsw/portfolios/nemotron/users/dmisra/nemo-rl
    ;;
  DFW)
    export LOGIN_HOST=dmisra@cw-dfw-cs-001-login-02
    export SLURM_ACCOUNT=nemotron_n4_post
    export GPUS_PER_NODE=8   # batch nodes are gpu:8 (x86_64): 4 nodes = 32 GPUs, DP=2
    export SEED_PARTITION=cpu   # x86_64 CPU nodes, so the image must be amd64 too
    # DFW is x86_64: the arm64 rc4 sqsh fails with "Exec format error". Needs the amd64 build of the same rc4
    # (its uv.lock md5 must be bad282a419cdfeecddfc3edc9198a4c5, like r0.8.0).
    export CONTAINER=/REPLACE_WITH_AMD64_RC4.sqsh
    export REMOTE_REPO_DIR=/lustre/fsw/portfolios/nemotron/users/dmisra/omega
    # Nothing exists on DFW yet: keep the HF cache, BIRD databases and uv cache inside the checkout dir.
    export SHARED_DIR="${REMOTE_REPO_DIR}"
    ;;
  AGA)
    # oci-aga-slurm-1: aarch64 everywhere (cpu partition too), NVL72 nodes with gpu:4 -- same layout as CMH.
    export LOGIN_HOST=dmisra@oci-aga-slurm-1-login-01
    export SLURM_ACCOUNT=REPLACE_WITH_AGA_ACCOUNT   # sacctmgr -nP show assoc user=dmisra format=account,partition
    export GPUS_PER_NODE=4
    export SEED_PARTITION=cpu
    export CONTAINER=/REPLACE_WITH_AGA_PATH_TO/nemo-rl-v0.8.0.rc4-arm64.sqsh   # copy of the CMH arm64 sqsh
    export REMOTE_REPO_DIR=/lustre/fsw/portfolios/nemotron/users/dmisra/omega   # check this dir is yours on AGA
    # Nothing exists on AGA yet: keep the HF cache, BIRD databases and uv cache inside the checkout dir.
    export SHARED_DIR="${REMOTE_REPO_DIR}"
    ;;
  HSG)
    # oci-hsg-cs-001: aarch64 everywhere (cpu partition too), NVL72 nodes with gpu:4 -- same layout as CMH.
    export LOGIN_HOST=dmisra@oci-hsg-cs-001-login-01
    export SLURM_ACCOUNT=nemotron_n4_post   # also has nemotron_reason_code
    export GPUS_PER_NODE=4
    export SEED_PARTITION=cpu
    export CONTAINER=/lustre/fsw/portfolios/nemotron/users/dmisra/containers/nemo-rl-v0.8.0.rc4-arm64.sqsh   # rsync'd from CMH
    export REMOTE_REPO_DIR=/lustre/fsw/portfolios/nemotron/users/dmisra/omega   # check this dir is yours on HSG
    # Nothing exists on HSG yet: keep the HF cache, BIRD databases and uv cache inside the checkout dir.
    export SHARED_DIR="${REMOTE_REPO_DIR}"
    ;;
  *)
    echo "ERROR: Unknown CLUSTER='${CLUSTER}' -- must be CMH, DFW, AGA or HSG" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
if [[ "${CONTAINER}" == *REPLACE_WITH_* || "${SLURM_ACCOUNT}" == *REPLACE_WITH_* ]]; then
  echo "ERROR: set CONTAINER/SLURM_ACCOUNT for CLUSTER=${CLUSTER} before launching." >&2
  return 1 2>/dev/null || exit 1
fi

export SYNC=0
# Rsync only grpo_birdbench*.yaml (not the whole configs dir) so the release branch's own configs are untouched.
export SYNC_CONFIGS=1

# ---- Model ----
export MODEL_NAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16

# Shared-filesystem HF cache: the Megatron backend converts the HF checkpoint on rank 0 and the other ranks/nodes
# read it back. Unset, it falls back to the container's node-local cache ("Pretrained run config not found...").
export HF_HOME="${SHARED_DIR}/hf_home"

# ---- Algorithm + data ----
export ALGO=grpo  # launcher entrypoint (examples/nemo_gym/run_grpo_nemo_gym.py); covers GRPO, CISPO and Omega
# METHOD picks the config twin: grpo -> grpo_birdbench.yaml (CISPO: loss_fn.use_cispo=true there), omega -> omega_birdbench.yaml.
# Omega needs REMOTE_REPO_DIR on the omega-algo branch (the launcher checks).

# METHOD can be omega vs grpo
export METHOD=grpo
export CONFIG="examples/configs/${METHOD}_birdbench.yaml"

# Full v3 data: prompts up to ~23k tokens, which fit the 32768-token config. Copy these into ${REMOTE_REPO_DIR}/examples/data/.
export TRAIN_DATA_PATH="${REMOTE_REPO_DIR}/examples/data/birdbench_uberset_rl_train_2400_random_subset.jsonl"
# export TRAIN_DATA_PATH="${REMOTE_REPO_DIR}/examples/data/birdbench_uberset_rl_train_2137_ushaped.jsonl"
export VAL_DATA_PATH="${REMOTE_REPO_DIR}/examples/data/birdbench_rl_620_dev.jsonl"

# Reward-server settings: one split + one dialect per run. They must match the data (train db_ids,
# prompts saying "Database Engine: SQLite").
export BIRD_SQL_SPLIT=train      # "train" or "dev"
export BIRD_SQL_DIALECT=sqlite   # "sqlite" or "spark"
# <dir>/train/train_databases/<db_id>/<db_id>.sqlite. Mounted read-only for training; the seed downloads it if missing (~9 GB).
export BIRD_SQL_DB_DIR="${SHARED_DIR}/bird_sql_databases"

# Megatron backend: the launcher defaults to the DTensor "automodel" extra.
export UV_EXTRA=mcore
# The image's baked environment is the BASE one: the mcore extra (Megatron-Bridge, TE, ...) is added by `uv run --extra mcore`
# at start-up, so the driver must sync (--no-sync fails: "No module named 'megatron.bridge'"). That sync worked in ~6 min
# with a cache dir on lustre and stalled for 19+ min with the image's default cache, so point it at the lustre cache.
export UV_RUN_NO_SYNC=0
export UV_SYNC_CACHE_DIR="${SHARED_DIR}/uv_cache"
# ...but sync into the image's prebuilt Megatron actor venv (exactly the mcore extra, all CUDA extensions already compiled
# from this same uv.lock), not the base env: then `uv run` only adds nemo-rl itself instead of compiling flash-attn & co.
# The driver alone uses it (GRPO's workers use MegatronPolicyWorker's venv); writes stay in the job's container.
export UV_PROJECT_ENVIRONMENT=/opt/ray_venvs/nemo_rl.models.value.workers.megatron_value_worker.MegatronValueWorker
# Run the code and the Gym servers from this checkout (birdspark Gym: bird_sql with split/dialect), not the image's
# baked copy. rw because `uv run` writes nemo_rl.egg-info into it, so don't run two jobs from the same checkout at once.
export CONTAINER_CODE_ROOT=/opt/nemo-rl
export CONTAINER_CODE_MOUNT_MODE=rw
# Gym server venvs live on lustre (tied to this image: delete + re-seed if the image changes). No separate uv cache.
export GYM_VENV_DIR="${REMOTE_REPO_DIR}/gym_venvs"
# birdspark Gym pins openai==2.44.0, newer than the image's NemoGym actor venv. ray.sub runs this on every node before
# Ray starts; bounded so a slow download can't idle the GPUs, `|| true` so a failure surfaces at Gym start-up instead.
export SETUP_COMMAND="timeout 300 uv pip install --python /opt/ray_venvs/nemo_rl.environments.nemo_gym.NemoGym/bin/python -r /opt/nemo-rl/3rdparty/Gym-workspace/Gym/pyproject.toml || true"

# Sync Ray session logs (raylet/worker/driver errors) from each node's /tmp/ray into
# <BASE_LOG_DIR>/<jobid>-logs/ray/ every N seconds, so they survive job end.
export RAY_LOG_SYNC_FREQUENCY=10

# ---- Seed job (SEED_GYM_VENVS=1): Gym server venvs, uv cache, model; CPU only ----
export SEED_SKIP_ENV_SYNC=1   # the image already holds this checkout's environment
# An empty uv cache (HSG) compiles flash-attn, deep-ep, causal-conv1d, flash-mla from source: give it cores, memory and time.
# Builds that finish are cached in UV_SYNC_CACHE_DIR, so a killed seed resumes where it stopped.
export SEED_CPUS=32
export SEED_MEM=128G
export SEED_WALLTIME=4:00:00
export SEED_MAX_JOBS=16
export SEED_CONCURRENT_BUILDS=2
export SEED_BUILD_ENV="FLASH_ATTN_CUDA_ARCHS=100"   # flash-attn for GB200 (sm100) only, not four architectures

# ---- Cluster shape ----
export PARTITION=batch
export NUM_NODES=4

# ---- Logs and W&B ----
# A new EXP_NAME = a fresh run; the same name resumes from its checkpoint.
export EXP_NAME="Omega-test-alg-${METHOD}-lr-2e-6-no-tis-random-subset-lightning-run1"

export BASE_LOG_DIR="${REMOTE_REPO_DIR}/results/${EXP_NAME}"
export WANDB_NAME="${EXP_NAME}"
# JOB_NAME defaults to "${ALGO}-multinode"; tie it to EXP_NAME so SINGLETON=1 (--dependency=singleton)
# doesn't queue a second run behind a first one with a different EXP_NAME.
export JOB_NAME="${EXP_NAME}"
export WANDB_PROJECT=birdbench-offline-rl

# ---- Handy for a first smoke test ----
export DRY_RUN=0       # 1 prints the sbatch command without submitting
export INTERACTIVE=0   # 1 = idle Ray allocation + attach script, for iterating
export USE_SNAPSHOT=config  # freezes just the config file (fast); protects a queued job from SYNC_CONFIGS
