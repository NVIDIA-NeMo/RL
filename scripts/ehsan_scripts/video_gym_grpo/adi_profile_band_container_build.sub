#!/usr/bin/env bash
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --time=02:00:00
#SBATCH --job-name=adi-profile-band-container-build

set -euo pipefail

readonly image_ref=gitlab-master.nvidia.com#yifuw/images/nemo-rl:main_20260807_super_ultra_omni_prefetched_venvs_x86_64
readonly output_dir=/lustre/fsw/portfolios/llmservice/users/ehosseiniasl/github_repos/nemorl/RL-3604/.cache/containers
readonly output_file=${output_dir}/nemo-rl-main_20260807_super_ultra_omni_prefetched_venvs_x86_64-pyxis.sqsh
readonly partial_file=${output_file}.inprogress

test ! -e "${output_file}"
test ! -e "${partial_file}"
mkdir -p "${output_dir}"

echo "CONTAINER_BUILD_START job=${SLURM_JOB_ID} account=${SLURM_JOB_ACCOUNT} partition=${SLURM_JOB_PARTITION}"

srun \
  --mpi=pmix \
  --no-container-mount-home \
  --container-image="${image_ref}" \
  --container-save="${partial_file}" \
  bash -lc '
    set -euo pipefail
    /opt/nemo_rl_venv/bin/python -c "import sys; print(sys.version); assert sys.version_info >= (3, 13, 14)"
    gym_vllm_python=/opt/gym_venvs/responses_api_models/vllm_model/.venv/bin/python
    stat -c "GYM_VLLM_PYTHON type=%F mode=%a size=%s path=%n" "${gym_vllm_python}"
    test -x "${gym_vllm_python}"
    "${gym_vllm_python}" -c "import vllm, vllm._C; print(\"GYM_VLLM_IMPORT_OK\", vllm.__version__)"
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
  '

mv "${partial_file}" "${output_file}"
echo "CONTAINER_BUILD_PASS job=${SLURM_JOB_ID} output=${output_file}"
