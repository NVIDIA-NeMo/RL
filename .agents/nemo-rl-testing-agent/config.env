# Single source of truth for every tunable the nemo-rl-testing-agent uses.
# Plain KEY=value only: no logic, no shell substitutions except $HOME, and no
# references to other keys, so both bash (`source`) and Python can read it.
# Change behaviour here rather than in the scripts or the skills.

# --- GitHub ------------------------------------------------------------------
# Repo whose labeled PRs are tested, and the label that opts a PR in.
MEGATRON_REPO=NVIDIA/Megatron-LM
MEGATRON_BASE_BRANCH=main
MEGATRON_CLONE_URL=https://github.com/NVIDIA/Megatron-LM.git
PR_LABEL=NemoRLTest
# Repos a fix may land in.
NEMO_RL_REPO=NVIDIA-NeMo/RL
MEGATRON_BRIDGE_REPO=NVIDIA-NeMo/Megatron-Bridge

# --- NeMo-RL revision under test -----------------------------------------------
# NeMo-RL is the third leg of the stack and has to be pinned as explicitly as
# megatron-core and Megatron-Bridge. It used to be whatever happened to be in the
# operator's working tree, which meant two runs a day apart were not comparable
# and no report said which NeMo-RL was tested.
NEMO_RL_CLONE_URL=https://github.com/NVIDIA-NeMo/RL.git
NEMO_RL_BASE_BRANCH=main
# Long-lived branch carrying `main` plus every agent fix that is raised but not
# yet merged. Runs test against this rather than bare `main` so that a bug already
# diagnosed and fixed on one labeled PR does not keep re-breaking the suite (and
# re-consuming a debugging budget) on every later PR while its review is pending.
# Lives on a fork to keep a rebased, force-pushed branch out of the shared repo.
NEMO_RL_FORK_REPO=shanmugamr1992/RL
NEMO_RL_FORK_URL=https://github.com/shanmugamr1992/RL.git
NEMO_RL_INTEGRATION_BRANCH=nrlta/integration

# --- Test suites (paths relative to the NeMo-RL repo root) --------------------
L1_SUITE=tests/functional/L1_Functional_Tests_Megatron_4.sh
L2_SUITE=tests/functional/L2_Functional_Tests_Megatron_4.sh
# Commit on the agent branch that adds L2_SUITE (not yet on NeMo-RL main).
# sync_integration.sh re-cherry-picks this after every rebuild so the carry
# cannot be silently dropped.
L2_SUITE_CARRY_COMMIT=8145a1d9fb8f51205e3e44045a0943bf55958d35

# --- Cluster / cog ------------------------------------------------------------
COG_CLUSTER=oci-hsg
COG_PARTITION=batch
CLUSTER_SSH_ALIAS=oci
# cog has no --qos flag; it reads this name straight out of the environment, and
# lib.sh exports everything here, so setting it is enough. Worth setting: the
# default `normal` QOS has priority 100 against `interactive`'s 700, and on a busy
# day that is the difference between starting in seconds and sitting 14h behind
# ~850 higher-priority jobs with no slot even planned. Identical resource request
# either way. Stay inside the interactive caps (4 nodes and 8 jobs per user, which
# fit L1's 1 node and L2's 2) and expect preemption -- interactive jobs do get
# killed mid-run, which shows up as an infra failure and needs a re-submit.
COG_SLURM_QOS=interactive
# oci-hsg QOS requires whole-node GPU jobs, so this is always 4 on GB200.
GPUS_PER_NODE=4
# L1 is single-node; L2 is a 2-node `--launcher ray` job (1 gen + 1 train node).
L1_NODES=1
L1_TIME=04:00:00
L2_NODES=2
L2_TIME=04:00:00
# `batch` MaxTime is 04:00:00. Use `batch_long` for anything longer.
CLUSTER_RUNS_ROOT=/lustre/fsw/portfolios/coreai/users/shanmugamr/agents-space/runs
CLUSTER_ARTIFACTS_ROOT=/lustre/fsw/portfolios/coreai/users/shanmugamr/agents-space/nemo-rl-testing-agent

# --- Paths inside the container ------------------------------------------------
# The nightly image ships a complete NeMo-RL checkout with editable installs.
CONTAINER_ROOT=/opt/nemo-rl
# megatron-core is editable-installed from this nested submodule, so checking a
# PR revision out here is enough to test it.
CONTAINER_MCORE_DIR=/opt/nemo-rl/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM
# Megatron-Bridge sits between NeMo-RL and megatron-core and is also editable
# installed. The image's Bridge is only as new as the image, so swapping in a
# current megatron-core alone tests an incompatible pair: a month-old image once
# failed every test with `ImportError: cannot import name
# get_default_save_sharded_strategy` because its Bridge still used an mcore shim
# that mcore had removed. Prep therefore pins Bridge too -- by default to the sha
# this NeMo-RL checkout pins, which is the combination NeMo-RL actually ships.
CONTAINER_BRIDGE_DIR=/opt/nemo-rl/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge
MEGATRON_BRIDGE_CLONE_URL=https://github.com/NVIDIA-NeMo/Megatron-Bridge.git
# Path of the Bridge submodule within the NeMo-RL repo, used to read that pin.
BRIDGE_SUBMODULE_PATH=3rdparty/Megatron-Bridge-workspace/Megatron-Bridge

# --- L2 (nano-3.5) inputs ------------------------------------------------------
NANO35_MODEL_DIR=/lustre/fsw/portfolios/llmservice/users/ksanthanam/nemotron-3.5-nano-swe-step25/without_mtp
NANO35_HF_DIR=/lustre/fsw/portfolios/llmservice/users/dmosallanezh/nemo-evaluator-rundirs/nano_v35/conversions/geshen_ultra_rl_v5_kd600_step30_fixedpath_20260520_1130/hf
# cog only auto-mounts the coreai scratch root; the nano-3.5 inputs live under
# llmservice and must be mounted explicitly.
L2_EXTRA_MOUNTS=/lustre/fsw/portfolios/llmservice/users/ksanthanam:/lustre/fsw/portfolios/llmservice/users/ksanthanam,/lustre/fsw/portfolios/llmservice/users/dmosallanezh:/lustre/fsw/portfolios/llmservice/users/dmosallanezh

# --- Local ---------------------------------------------------------------------
# The checkout cog syncs to the cluster. `prep_container.sh` and
# `run_suite_remote.sh` execute from that synced copy, so this must be the same
# checkout the agent tooling is edited in -- when it pointed at a second clone,
# edits to either script stopped reaching the cluster with nothing to show for it.
NEMO_RL_REPO_PATH=$HOME/temp/RL
# One KEY=value per line; provides HF_TOKEN, WANDB_API_KEY, GITHUB_TOKEN, ...
TOKENS_FILE=/Users/shanmugamr@nvidia.com/tokens
# Per-PR ledger, cog logs, and results JSON live here (outside the repo).
STATE_DIR=$HOME/.nemo-rl-testing-agent
# Cross-PR memory: every failure the agent has already diagnosed, keyed by test
# and normalized error signature, with the fix branch/PR and its state. Consulted
# before spending a debugging budget so the same break is never re-derived.
KNOWN_ISSUES_FILE=$HOME/.nemo-rl-testing-agent/known_issues.json
# Queue of corrections the agent owes its own instructions: a flag the skills do
# not mention, a step whose order matters, a symptom that means something else.
# Recorded mid-sweep and promoted into the skills/scripts/config at the end of
# one, so operating knowledge outlives the context window that discovered it.
LEARNINGS_FILE=$HOME/.nemo-rl-testing-agent/learnings.json
# Fix attempts allowed per failing test before giving up and reporting.
MAX_FIX_ATTEMPTS=4
# Wall-clock budget for all fix work on a single PR.
MAX_FIX_HOURS=2
