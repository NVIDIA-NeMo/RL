# =============================================================================
# swe_nano.env — adapted from branch zhiyul/swe_tq's swe_nano.env for the
# current `main` checkout in this project tree.
#
# See docs/guides/nano-swe-transferqueue.md (branch zhiyul/swe_tq) for full
# rationale, and NANO_SWE_TQ_MAINPORT_NOTES.md for what changed vs. the
# branch and why. This file only changes WHERE things live, not the recipe
# itself.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — WANDB_API_KEY / HF_TOKEN. Sourced BEFORE the per-user paths below
# so this file's HF_HOME still wins.
# -----------------------------------------------------------------------------
NRL_SECRETS_FILE="${NRL_SECRETS_FILE:-/lustre/fs1/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/secrets.sh}"
if [[ -r "${NRL_SECRETS_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${NRL_SECRETS_FILE}"
  echo "[SECRETS] sourced ${NRL_SECRETS_FILE} (wandb=${WANDB_API_KEY:+set} hf=${HF_TOKEN:+set})"
else
  echo "[WARN] no secrets file at ${NRL_SECRETS_FILE} — W&B logging will be disabled and HF downloads unauthenticated." >&2
fi

export NRL_FORCE_REBUILD_VENVS=false
export NCCL_MAX_NCHANNELS=1
export NCCL_NVLS_ENABLE=0

# -----------------------------------------------------------------------------
# READ-ONLY, this project's own tree — no cross-project dependency needed;
# ultra_data/ (swe.train.jsonl, swe.val.jsonl) already lives in this checkout.
# -----------------------------------------------------------------------------
export CONTAINER=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/enroot-images/nightly_gym_20260810.sqsh
export SANDBOX_CONTAINER=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/containers/nemo-skills-sandbox.sqsh

export DATA_DIR=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/RL/ultra_data
export SIF_DIR=/lustre/fsw/portfolios/llmservice/users/sdevare/images
export MODEL_PATH=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16

# -----------------------------------------------------------------------------
# PER-USER WRITE — this project's own paths (verified present/non-empty).
# -----------------------------------------------------------------------------
export CODE_DIR=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/RL
export WORKSPACE_DIR=${CODE_DIR}/workspace

export HF_HOME=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/hf_cache
export PERSISTENT_CACHE=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/persistent_cache
export NRL_MEGATRON_CHECKPOINT_DIR=${PERSISTENT_CACHE}/megatron_ckpt_cache

# Shared Gym venv dir. MUST be a directory this exact container has built,
# not just "this project's own" -- job 6279915 proved the June-30 cache under
# .../zhiyul/gym_venvs (this project's own, not even the branch's) is ALSO
# stale: `uv venv --seed` writes bin/python as a symlink into the BUILDING
# container's ephemeral /root/.local/share/uv/python/..., which does not
# survive a container swap (confirmed dangling: `readlink -f bin/python`
# resolves to a target that doesn't exist in the nightly-gym 2026-08-10
# container). `skip_venv_if_present` composition IS correctly resolving to
# True (confirmed in the resolved MasterConfig dump in ray-driver.log), but
# Gym's own check is `bool(skip_venv_if_present) and venv_python_fpath.exists()
# and venv_activate_fpath.exists()` (setup_command.py:116-117) -- a dangling
# symlink makes .exists() False regardless, forcing the rebuild path. The
# rebuild then failed because swe_agents_train and swe_agents_val are two
# separate Gym server processes that share the IDENTICAL venv path
# (responses_api_agents/swe_agents/.venv) and raced rebuilding it concurrently
# -- swe_agents_val won (pip==26.2.1 installed cleanly), swe_agents_train lost
# the race deleting swe_agents_val's already-removed stale pip dist-info
# (os error 2). A genuinely fresh, empty directory sidesteps the stale-content
# deletion race entirely (first-time creation, nothing to reconcile/delete);
# kept as a STABLE (not per-run-timestamped) path so a later successful build
# benefits future retries via skip_venv_if_present's fast path.
export NANO_SWE_GYM_VENV_DIR=/lustre/fsw/portfolios/llmservice/projects/llmservice_nemo_reasoning/users/zhiyul/RL/gym_venvs_mainport

# Slurm identity.
export SLURM_PARTITION=batch
export SLURM_ACCOUNT=nemotron_sw_post
export GPUS_PER_NODE=4

# Nano SWE shape (train 4 / gen 2 / gym 0 = 6 nodes total). Reverted from the
# 8-node (NUM_GEN_NODES=4, doubled engine count) attempt -- couldn't get a
# confirmed short-QOS node-cap number from the cluster (scontrol assoc_mgr
# query returned an unusable dump), so isolating variables: keep the
# proven 6-node shape, test the 196608-context bump on its own first.
export NUM_TRAIN_NODES=4
export NUM_GEN_NODES=2
export NUM_GYM_NODES=0
export SEGMENT_SIZE=6

# Back to short QOS / <2h walltime as the default (user's choice) -- proven at
# this 6-node shape (job 6278584/6292902). The 196608-context run is untested
# against this 2h ceiling (longer context -> slower generation), so if it runs
# out of time that's the tradeoff to revisit, not a bug. Matches the local
# time-fixed ray.sub.nano-swe-local copy this launcher points RAY_SUB at (also
# reverted to #SBATCH --time=1:59:00).
export WALLTIME="${WALLTIME:-1:59:00}"
export SLURM_QOS="${SLURM_QOS-short}"
export NRL_MAX_STEPS=5

export ENABLE_MTP_INFERENCE=0
export USE_CUSTOM_VLLM=0

# Mount RL's own Gym submodule writable (SWE/OpenHands harness writes at
# runtime) plus a broad /lustre mount so the entrypoint can be spawned by
# absolute host path from CODE_DIR.
export EXTRA_MOUNTS=/lustre:/lustre,${CODE_DIR}/3rdparty/Gym-workspace/Gym:/opt/nemo-rl/3rdparty/Gym-workspace/Gym
export WANDB_PROJ=nano-swe-smoke

# Start safe: inspect the resolved launch command before submission.
export DRY_RUN="${DRY_RUN:-1}"
export USE_SNAPSHOT=0

export EXP_NAME=nano-swe-teacher-qwen3mesh-mainport
export CONFIG_PATH=${CODE_DIR}/examples/configs/ultra/nano_swe_teacher_qwen3mesh.yaml
export TRAIN_PATH=${DATA_DIR}/swe.train.jsonl
export VAL_PATH=${DATA_DIR}/swe.val.jsonl

export RESULTS_DIR=${WORKSPACE_DIR}/results/${EXP_NAME}
export BASE_LOG_DIR=${WORKSPACE_DIR}/ray_logs/${EXP_NAME}

export NRL_WG_USE_RAY_REF=1
