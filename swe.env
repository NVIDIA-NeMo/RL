# =============================================================================
# Nemotron 3 ULTRA (550B-A55B) — SWE Teacher — TINY 48-node smoke — GB200
# =============================================================================
# Pairs with examples/configs/ultra/tiny_swe_teacher.yaml. Runs the full 196k
# context with a 16-sample global batch to validate the SWE-agent rollout,
# per-instance SIF execution, reward, and training paths.
#
# # Source the user's shared credentials and low-level NCCL settings.
# source "$(dirname "${BASH_SOURCE[0]}")/../../.env"
export NRL_FORCE_REBUILD_VENVS=false
export NCCL_MAX_NCHANNELS=1
export NCCL_NVLS_ENABLE=0

# zhiyul RL-copy: code from this checkout (fsw literal; the fsw path is a symlink
# to the fs1 RL-copy, so both resolve to the same tree — do NOT realpath to fs1).
export CODE_DIR=/lustre/fsw/portfolios/llmservice/users/zhiyul/RL-copy
export WORKSPACE_DIR=${CODE_DIR}/workspace
# DATA_DIR kept at cye's copy — swe.jsonl is world-readable, no need to duplicate.
export DATA_DIR=/lustre/fsw/portfolios/coreai/users/cye/code/RL-debug-ultra/workspace/data

# CHANGEME: Ultra runs need a container that ships the Ultra vLLM fork at
# /opt/nemo-rl/3rdparty/vllm (USE_CUSTOM_VLLM=1 sources its nemo-rl.env). The
# nano nightly-gym image may not include it.
# nemo-rl:nightly_20260715_prefetch_venvs.squashfs or nemo_rl_ultra_gb200_cuda2605_nccl2304.sqsh
export CONTAINER=/lustre/fsw/portfolios/llmservice/users/zhiyul/enroot-images/gitlab-master.nvidia.com+yifuw+images+rl+ultra_gb200_forcenccl_20260724_prefetch_venvs.2026-07-25.squashfs

export SANDBOX_CONTAINER=/lustre/fsw/portfolios/coreai/users/cye/enroot/nemo-rl:skills-sandbox-latest.squashfs
# CHANGEME: any Ultra checkpoint works for this smoke (SFT ckpt is fine).
export MODEL_PATH=/lustre/fsw/portfolios/llmservice/users/jiaqiz/results/ultra-v3-pipeclean/pipeclean-ultra-rl-prod_ultra_stage2sft300_fixlc_tp8_cp8_ep64_pp1_gpp16_pps512_gbs8192-20260417-jiaqi-resumestep128-65k/eval/step_152/hf
# zhiyul-writable caches (amahishi's are read-only to me). /lustre:/lustre mounts these.
export HF_HOME=/lustre/fsw/portfolios/llmservice/users/zhiyul/hf_cache
export PERSISTENT_CACHE=/lustre/fsw/portfolios/llmservice/users/zhiyul/persistent_cache
export NRL_MEGATRON_CHECKPOINT_DIR=/lustre/fsw/portfolios/llmservice/users/zhiyul/persistent_cache/megatron_ckpt_cache

# SWE rewards come from executing each instance in its SIF image; no GPU judge
# fleet is needed. This root must contain swerebench/ and swegym/ subdirectories.
export SIF_DIR=/lustre/fsw/portfolios/llmservice/users/sdevare/images

export SLURM_PARTITION=batch
export SLURM_ACCOUNT=nemotron_sw_post # nemotron_sw_post coreai_dlalgo_mcore
export GPUS_PER_NODE=4          # GB200 NVL72
# export CPUS_PER_WORKER=72       # Grace has 72 cores/socket
export SEGMENT_SIZE=16

# Tiny non-colocated Ultra SWE shape on GB200 (4 GPUs/node), 48 nodes total:
#   Train 32 nodes (128 GPUs) = TP8*PP1*CP16*DP1, experts on EP32
#   Gen   16 nodes ( 64 GPUs) = 8 vLLM engines at TP=8
#   Gym    0 nodes            = code-execution rewards use the sandbox + SIFs
export NUM_TRAIN_NODES=32
export NUM_GEN_NODES=16   # min legal gen (>0, total%16==0) -> 48-node GBS-128 smoke
export NUM_GYM_NODES=0
export WALLTIME="${WALLTIME:-1:59:00}"      # <2h → QOS short (prio 200, MaxNodes 64) auto-selected; caller-overridable
export SLURM_QOS="${SLURM_QOS-short}"        # use `-` so an explicit empty (SLURM_QOS=) clears it → default QOS for >2h walltimes
export NRL_MAX_STEPS="${NRL_MAX_STEPS:-11}"  # caller-overridable

# MTP is disabled by the SWE recipe (mtp_num_layers=0).
export ENABLE_MTP_INFERENCE=0
export USE_CUSTOM_VLLM=0

# Mount rl-cye's OWN Gym (writable by zhiyul, byte-identical source d67ad66) — the
# SWE/OpenHands harness writes into this dir at runtime, so it must be zhiyul-writable.
# (cye's Gym is owner=nobody + has files zhiyul can't read; /lustre:/lustre covers the rest.)
export EXTRA_MOUNTS=/lustre:/lustre,${CODE_DIR}/3rdparty/Gym-workspace/Gym:/opt/nemo-rl/3rdparty/Gym-workspace/Gym
export NRL_FORCE_REBUILD_VENVS=false
export WANDB_PROJ=ultra-posttraining-smoke

# Start safely: inspect the fully resolved launch command before submission.
export DRY_RUN=1
# The tiny configs may be uncommitted while iterating; mount this live checkout.
export USE_SNAPSHOT=0

export EXP_NAME=ultra-swe-teacher-cp16-65k-zhiyul-rlcopy
export CONFIG_PATH=${CODE_DIR}/examples/configs/ultra/tiny_swe_teacher.yaml
export TRAIN_PATH=${DATA_DIR}/swe.jsonl
export VAL_PATH=${DATA_DIR}/swe.jsonl

export RESULTS_DIR=${WORKSPACE_DIR}/results/${EXP_NAME}
export BASE_LOG_DIR=${WORKSPACE_DIR}/ray_logs/${EXP_NAME}

export NRL_WG_USE_RAY_REF=1
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=COLL,NET
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export TORCH_NCCL_DESYNC_DEBUG=1
export TORCH_NCCL_DUMP_ON_TIMEOUT=1
export TORCH_NCCL_TRACE_BUFFER_SIZE=200000
