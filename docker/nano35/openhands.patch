@@ -1002,7 +1002,13 @@ def initialize_runtime(
     workspace_path = _get_workspace_path(instance, workspace_dir_name)
     obs: CmdOutputObservation
 
+    # Lyris arm64 SIF fixes (RC6/RC8, see erinh GYM_VENV_DEBUG.md): the SIF's
+    # unguarded ~/.bashrc exits early in non-interactive shells, so exports
+    # appended to it never reach the session — export inline instead. The SIFs
+    # also ship an x86_64 /usr/local/bin/jq shadowing the arm64 one.
     initial_setup_cmd = f"""
+rm -f /usr/local/bin/jq && \
+export SWE_INSTANCE_ID={instance['instance_id']} && \
 echo 'export SWE_INSTANCE_ID={instance['instance_id']}' >> ~/.bashrc && \
 echo 'export PIP_CACHE_DIR=~/.cache/pip' >> ~/.bashrc && \
 echo "alias git='git --no-pager'" >> ~/.bashrc && \
@@ -1064,14 +1070,24 @@ source ~/.bashrc
     SKIP_ENTRY_SCRIPT_TYPES = ('nv-internal-1', 'SWE-rebench-V2', 'SWE-Gym', 'R2E-Gym', 'swe-bench-ext', 'deepswe')
 
     if DATASET_TYPE not in SKIP_ENTRY_SCRIPT_TYPES:
-        action = CmdRunAction(command=f'source /swe_util/{entry_script_path}')
+        # Lyris arm64 SIF fix (RC7): `source` runs the entry script inside the
+        # BashSession shell — the SIF's entry script ends with a bare `exit 1`
+        # path that kills the session. Run it in a subshell instead, then
+        # activate the conda env it prepares.
+        action = CmdRunAction(
+            command=(
+                f'bash /swe_util/{entry_script_path} && '
+                f'source /opt/miniconda3/etc/profile.d/conda.sh && '
+                f'conda activate testbed'
+            )
+        )
         action.set_hard_timeout(600)
         logger.info(action, extra={'msg_type': 'ACTION'})
         obs = _run_harness_action(runtime, action)
         logger.info(obs, extra={'msg_type': 'OBSERVATION'})
         assert_and_raise(
             obs.exit_code == 0,
-            f'Failed to source /swe_util/{entry_script_path}: {str(obs)}',
+            f'Failed to run /swe_util/{entry_script_path}: {str(obs)}',
         )
     elif DATASET_TYPE == 'SWE-Gym':
         # SWE-Gym: activate conda testbed environment
