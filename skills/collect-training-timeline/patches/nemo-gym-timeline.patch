+def _append_timeline_event(
+    path: Path,
+    name: str,
+    category: str,
+    rollout_id: str,
+    start_epoch_ns: int,
+    duration_ns: int,
+    *,
+    status: str = "ok",
+    error_type: Optional[str] = None,
+) -> None:
+    """Append one best-effort Chrome complete event (collect-training-timeline skill)."""
+    args = {
+        "hostname": socket.gethostname(),
+        "source": "nemo_gym",
+        "rollout_id": rollout_id,
+        "status": status,
+    }
+    if error_type is not None:
+        args["error_type"] = error_type
+    event = {
+        "name": name,
+        "cat": category,
+        "ph": "X",
+        "ts": start_epoch_ns / 1_000,
+        "dur": max(duration_ns, 0) / 1_000,
+        "pid": os.getpid(),
+        "tid": threading.get_native_id(),
+        "args": args,
+    }
+    try:
+        payload = (orjson.dumps(event).decode() + "\n").encode()
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
+        try:
+            os.write(fd, payload)
+        finally:
+            os.close(fd)
+    except (OSError, TypeError, ValueError):
+        pass
+
+
+@contextmanager
+def _timeline_span(path: Path, name: str, category: str, rollout_id: str) -> Generator[None, None, None]:
+    start_epoch_ns = time.time_ns()
+    start_perf_ns = time.perf_counter_ns()
+    try:
+        yield
+    except BaseException as error:
+        _append_timeline_event(
+            path,
+            name,
+            category,
+            rollout_id,
+            start_epoch_ns,
+            time.perf_counter_ns() - start_perf_ns,
+            status="error",
+            error_type=type(error).__name__,
+        )
+        raise
+    else:
+        _append_timeline_event(
+            path, name, category, rollout_id, start_epoch_ns, time.perf_counter_ns() - start_perf_ns
+        )
+
+
