+++ b/openhands/utils/nemo_gym_timeline.py
@@ -0,0 +1,202 @@
+"""Best-effort Chrome trace spans for NeMo Gym OpenHands rollouts."""
+
+import json
+import os
+import socket
+import threading
+import time
+from contextlib import contextmanager
+from typing import Any, Generator
+
+
+def nemo_gym_cache_metrics(usage: Any) -> dict[str, float | int]:
+    """Normalize OpenAI token usage into timeline metrics."""
+    if not isinstance(usage, dict):
+        return {}
+    metrics: dict[str, float | int] = {}
+    completion_tokens = usage.get("completion_tokens")
+    if (
+        isinstance(completion_tokens, int)
+        and not isinstance(completion_tokens, bool)
+        and completion_tokens >= 0
+    ):
+        metrics["decode_tokens"] = completion_tokens
+    prompt_tokens = usage.get("prompt_tokens")
+    valid_prompt_tokens = (
+        isinstance(prompt_tokens, int)
+        and not isinstance(prompt_tokens, bool)
+        and prompt_tokens >= 0
+    )
+    if valid_prompt_tokens:
+        metrics["prompt_tokens"] = prompt_tokens
+    prompt_token_details = usage.get("prompt_tokens_details") or {}
+    if not isinstance(prompt_token_details, dict):
+        return metrics
+    cached_prompt_tokens = prompt_token_details.get("cached_tokens")
+    if (
+        not valid_prompt_tokens
+        or not isinstance(cached_prompt_tokens, int)
+        or isinstance(cached_prompt_tokens, bool)
+        or not 0 <= cached_prompt_tokens <= prompt_tokens
+    ):
+        return metrics
+    metrics.update({
+        "cached_prompt_tokens": cached_prompt_tokens,
+        "uncached_prompt_tokens": prompt_tokens - cached_prompt_tokens,
+        "kv_cache_hit_rate": (
+            cached_prompt_tokens / prompt_tokens if prompt_tokens else 0.0
+        ),
+    })
+    return metrics
+
+
+def nemo_gym_llm_timing_metrics(response: Any) -> dict[str, int]:
+    """Copy valid LLM request milestones from a live completion response."""
+    if not isinstance(response, dict):
+        return {}
+    metrics: dict[str, int] = {}
+    for response_field, timeline_field in (
+        ("nemo_llm_arrival_ts_us", "llm_arrival_ts_us"),
+        ("nemo_llm_queued_ts_us", "queued_ts_us"),
+        (
+            "nemo_llm_first_scheduled_ts_us",
+            "first_scheduled_ts_us",
+        ),
+        ("nemo_llm_first_token_ts_us", "first_token_ts_us"),
+        ("nemo_llm_last_token_ts_us", "last_token_ts_us"),
+        (
+            "nemo_llm_response_ready_ts_us",
+            "llm_response_ready_ts_us",
+        ),
+        (
+            "nemo_gym_llm_response_received_ts_us",
+            "gym_llm_response_received_ts_us",
+        ),
+        ("nemo_gym_response_ready_ts_us", "gym_response_ready_ts_us"),
+    ):
+        value = response.get(response_field)
+        if (
+            isinstance(value, int)
+            and not isinstance(value, bool)
+            and value > 0
+        ):
+            metrics[timeline_field] = value
+    tokenize_duration_us = response.get("nemo_gym_tokenize_duration_us")
+    if (
+        isinstance(tokenize_duration_us, int)
+        and not isinstance(tokenize_duration_us, bool)
+        and tokenize_duration_us >= 0
+    ):
+        metrics["gym_tokenize_duration_us"] = tokenize_duration_us
+    return metrics
+
+
+def nemo_gym_disagg_metrics(response: Any) -> dict[str, int]:
+    """Copy the PD-disaggregation frontend and context-engine fields.
+
+    The TRT-LLM disagg server relays these onto the final (generation)
+    response. Context-side prefix reuse lives here, not in ``usage``: under
+    context-first disaggregation the generation leg's usage does not describe
+    the prefill that the context engine ran.
+    """
+    if not isinstance(response, dict):
+        return {}
+    metrics: dict[str, int] = {}
+    for response_field, timeline_field, minimum in (
+        ("nemo_fe_recv_ts_us", "frontend_recv_ts_us", 1),
+        ("nemo_fe_fwd_ts_us", "frontend_fwd_ts_us", 1),
+        ("nemo_ctx_arrival_ts_us", "ctx_arrival_ts_us", 1),
+        ("nemo_ctx_queued_ts_us", "ctx_queued_ts_us", 1),
+        ("nemo_ctx_first_scheduled_ts_us", "ctx_first_scheduled_ts_us", 1),
+        ("nemo_ctx_done_ts_us", "ctx_done_ts_us", 1),
+        ("nemo_ctx_cached_tokens", "ctx_cached_prompt_tokens", 0),
+        ("nemo_ctx_computed_tokens", "ctx_computed_tokens", 0),
+        ("nemo_ctx_first_begin", "ctx_first_begin", 0),
+        ("nemo_ctx_num_chunks", "ctx_num_chunks", 1),
+    ):
+        value = response.get(response_field)
+        if (
+            isinstance(value, int)
+            and not isinstance(value, bool)
+            and value >= minimum
+        ):
+            metrics[timeline_field] = value
+    return metrics
+
+
+def _append_event(
+    name: str,
+    category: str,
+    start_epoch_ns: int,
+    duration_ns: int,
+    args: dict[str, Any],
+) -> None:
+    path = os.environ.get("NEMO_GYM_TIMELINE_FPATH")
+    if not path:
+        return
+
+    event_args = {
+        "hostname": socket.gethostname(),
+        "source": "openhands",
+        "rollout_id": os.environ.get("NEMO_GYM_ROLLOUT_ID", "unknown"),
+        **args,
+    }
+    event = {
+        "name": name,
+        "cat": category,
+        "ph": "X",
+        "ts": start_epoch_ns / 1_000,
+        "dur": max(duration_ns, 0) / 1_000,
+        "pid": os.getpid(),
+        "tid": threading.get_native_id(),
+        "args": event_args,
+    }
+    try:
+        parent = os.path.dirname(path)
+        if parent:
+            os.makedirs(parent, exist_ok=True)
+        payload = (json.dumps(event, separators=(",", ":")) + "\n").encode()
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
+        try:
+            os.write(fd, payload)
+        finally:
+            os.close(fd)
+    except (OSError, TypeError, ValueError):
+        pass
+
+
+@contextmanager
+def nemo_gym_timeline_span(
+    name: str, category: str, **args: Any
+) -> Generator[dict[str, Any], None, None]:
+    """Record a complete event and allow numeric metadata updates."""
+    event_args = dict(args)
+    if not os.environ.get("NEMO_GYM_TIMELINE_FPATH"):
+        yield event_args
+        return
+
+    start_epoch_ns = time.time_ns()
+    start_perf_ns = time.perf_counter_ns()
+    try:
+        yield event_args
+    except BaseException as error:
+        _append_event(
+            name,
+            category,
+            start_epoch_ns,
+            time.perf_counter_ns() - start_perf_ns,
+            {
+                **event_args,
+                "status": "error",
+                "error_type": type(error).__name__,
+            },
+        )
+        raise
+    else:
+        _append_event(
+            name,
+            category,
+            start_epoch_ns,
+            time.perf_counter_ns() - start_perf_ns,
+            {**event_args, "status": "ok"},
+        )
