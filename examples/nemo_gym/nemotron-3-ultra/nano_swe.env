# =============================================================================
# Nemotron 3 NANO v3 (30B-A3B) — SWE Teacher — 6-node GB200 smoke
# =============================================================================
# Shared environment for the nano SWE launchers in this directory:
#
#   nano_swe_sc.sh              batch:       async GRPO via SingleController, TQ honoured
#   nano_swe_sc_interactive.sh  interactive: same shape, Ray idles so you can iterate
#
# Only run_grpo_single_controller.py gives async rollouts AND a real
# TransferQueue data plane; run_grpo_nemo_gym.py's async path uses an in-memory
# ReplayBuffer and silently ignores the data_plane block.
#
# -----------------------------------------------------------------------------
# EVERYTHING BELOW IS CLUSTER-SPECIFIC. Override any of it from the caller's
# environment (every assignment uses ${VAR:-default}), e.g.
#
#   SIF_DIR=/my/sif DATA_DIR=/my/data DRY_RUN=0 bash nano_swe_sc.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — sourced first so WANDB_API_KEY / HF_TOKEN are picked up without the
# caller exporting anything. ultra_launch.sh gates W&B on WANDB_API_KEY; HF_TOKEN
# removes the unauthenticated rate limit on the ~60 GB checkpoint download.
# -----------------------------------------------------------------------------
NRL_SECRETS_FILE="${NRL_SECRETS_FILE:-${HOME}/.nrl_secrets.sh}"
if [[ -r "${NRL_SECRETS_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${NRL_SECRETS_FILE}"
  echo "[SECRETS] sourced ${NRL_SECRETS_FILE} (wandb=${WANDB_API_KEY:+set} hf=${HF_TOKEN:+set})"
else
  echo "[WARN] no secrets file at ${NRL_SECRETS_FILE} — W&B logging disabled and HF downloads unauthenticated. Set NRL_SECRETS_FILE to override." >&2
fi

export NRL_FORCE_REBUILD_VENVS=false
export NCCL_MAX_NCHANNELS=1
export NCCL_NVLS_ENABLE=0

# -----------------------------------------------------------------------------
# Containers
# -----------------------------------------------------------------------------
# Training container (GB200 aarch64, prebuilt nemo-gym venvs).
# Required, like ray.sub and docs/cluster.md treat it. A date-stamped
# squashfs under one user's scratch is unreadable to everyone else and
# fails deep inside srun with nothing pointing back here.
: "${CONTAINER:?set CONTAINER to a squashfs path or an nvcr.io ref (see docs/cluster.md)}"
export CONTAINER
# nemo-skills sandbox sidecar. SWE rewards come from apptainer .sif images, not
# from this sandbox, but ray.sub gates the driver on sandbox readiness whenever
# SANDBOX_CONTAINER is set — and ultra_launch.sh hard-requires it. Build it from
# NeMo-Skills' dockerfiles/Dockerfile.sandbox; see docs/guides/nemotron-3-ultra.md.
export SANDBOX_CONTAINER="${SANDBOX_CONTAINER:-}"

# -----------------------------------------------------------------------------
# Model + data
# -----------------------------------------------------------------------------
# Nano v3 30B-A3B HF repo id (matches the nano_v3 reasoning parser in
# swe_teacher.yaml). Downloaded to HF_HOME on first run (~60 GB BF16).
export MODEL_PATH="${MODEL_PATH:-nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16}"

# SWE prompt set, split into train/val jsonl. Prepared from
# nvidia/Nemotron-RL-Super-Training-Blends — see docs/guides/swe-rl-qwen3.md.
export DATA_DIR="${DATA_DIR:-}"
export TRAIN_PATH="${TRAIN_PATH:-${DATA_DIR}/swe.train.jsonl}"
export VAL_PATH="${VAL_PATH:-${DATA_DIR}/swe.val.jsonl}"

# SWE rewards execute each instance inside its apptainer .sif image (no GPU
# judges). swe_teacher.yaml's container_formatter expects swerebench/ and
# swegym/ subdirectories of per-instance {instance_id}.sif files. Build with
# examples/nemo_gym/download_swe_images.py.
export SIF_DIR="${SIF_DIR:-}"

# -----------------------------------------------------------------------------
# Per-user write paths
# -----------------------------------------------------------------------------
# CODE_DIR is the checkout that gets mounted into the container, so it must be
# the tree you are actually editing.
# Derived from this file's location, not hardcoded: a personal path here
# silently bind-mounts one person's working tree into everyone else's run,
# so they would be reproducing that tree rather than their own checkout.
export CODE_DIR="${CODE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
export WORKSPACE_DIR="${WORKSPACE_DIR:-${CODE_DIR}/workspace}"

export HF_HOME="${HF_HOME:-/scratch/fsw/portfolios/nemotron/users/zhiyul/hf_cache}"
export PERSISTENT_CACHE="${PERSISTENT_CACHE:-/scratch/fsw/portfolios/nemotron/users/zhiyul/persistent_cache}"
export NRL_MEGATRON_CHECKPOINT_DIR="${NRL_MEGATRON_CHECKPOINT_DIR:-${PERSISTENT_CACHE}/megatron_ckpt_cache}"

# -----------------------------------------------------------------------------
# Slurm
# -----------------------------------------------------------------------------
export SLURM_PARTITION="${SLURM_PARTITION:-batch}"
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-nemotron_sw_pre}"
export GPUS_PER_NODE="${GPUS_PER_NODE:-4}"   # GB200 NVL72

# 6-node shape mirroring the Qwen3-30B-A3B MoE mesh:
#   Train 4 nodes (16 GPUs) = TP2 · PP2 · CP4 · DP1 (no EP)
#   Gen   2 nodes ( 8 GPUs) = vLLM TP2 -> 4 engines (non-colocated)
#   Gym   0 nodes           = code-execution SIF rewards
export NUM_TRAIN_NODES="${NUM_TRAIN_NODES:-4}"
export NUM_GEN_NODES="${NUM_GEN_NODES:-2}"
export NUM_GYM_NODES="${NUM_GYM_NODES:-0}"
# Total = 6; SEGMENT_SIZE must divide it (sbatch --segment). The nano .inc sets
# cluster.segment_size=null to disable the virtual-cluster NVLink segment filter.
export SEGMENT_SIZE="${SEGMENT_SIZE:-6}"

# 3:59:00 is the max for the `batch` partition. One hour is NOT enough: the first
# run downloads ~60 GB from HF and converts to Megatron before the first rollout.
export WALLTIME="${WALLTIME:-3:59:00}"
# Deliberately NOT the `short` QOS: it trades a priority boost for a 2h ceiling
# and a per-user node cap. ultra_launch.sh only auto-selects short when WALLTIME
# is under 2h, so leaving this empty submits with no --qos.
export SLURM_QOS="${SLURM_QOS-}"
export NRL_MAX_STEPS="${NRL_MAX_STEPS:-5}"

# Nano base checkpoint: MTP off, container's stock vLLM (no Ultra fork needed).
export ENABLE_MTP_INFERENCE="${ENABLE_MTP_INFERENCE:-0}"
export USE_CUSTOM_VLLM="${USE_CUSTOM_VLLM:-0}"

# ultra_launch.sh overlays only nemo_rl/ and examples/configs/ into the
# container. The nano configs and run_grpo_single_controller.py live outside
# both, so CONFIG_PATH / NRL_ENTRYPOINT are passed as absolute host paths and
# the filesystem holding CODE_DIR is mounted straight through.
export EXTRA_MOUNTS="${EXTRA_MOUNTS:-/scratch:/scratch}"
# Run from the live checkout so the mounted nemo_rl, the config and the
# entrypoint all come from one tree.
export USE_SNAPSHOT="${USE_SNAPSHOT:-0}"

export WANDB_PROJ="${WANDB_PROJ:-nano-swe-smoke}"
export NRL_WG_USE_RAY_REF=1

# Start safe: inspect the resolved launch command before submitting.
export DRY_RUN="${DRY_RUN:-1}"

# -----------------------------------------------------------------------------
# Preflight — fail here with a precise message rather than 20 minutes into the
# allocation. Each of these is an asset that has to exist on THIS cluster.
# -----------------------------------------------------------------------------
_nano_swe_preflight() {
  local missing=0
  local v path
  for v in CONTAINER SANDBOX_CONTAINER TRAIN_PATH VAL_PATH SIF_DIR; do
    path="${!v}"
    if [[ -z "${path}" ]]; then
      echo "[PREFLIGHT] ${v} is unset — see the comments in nano_swe.env" >&2
      missing=1
    elif [[ ! -e "${path}" ]]; then
      echo "[PREFLIGHT] ${v}=${path} does not exist" >&2
      missing=1
    fi
  done
  if (( missing )); then
    echo "[PREFLIGHT] refusing to launch; set the variables above and retry" >&2
    return 1
  fi
}
