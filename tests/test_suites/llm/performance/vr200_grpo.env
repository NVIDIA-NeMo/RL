source "$SCRIPT_DIR/common.env"

# Single-run recipes can reuse completed metrics, or resume a partial run from its checkpoint.
run_grpo_if_needed() {
  cd "$PROJECT_ROOT"
  if [[ -f "$JSON_METRICS" ]] && jq -e --arg step "$MAX_STEPS" '."train/loss" | has($step)' "$JSON_METRICS" > /dev/null; then
    echo "[INFO] Reusing recorded metrics for step $MAX_STEPS"
    return
  fi

  uv run examples/run_grpo.py \
    --config "$CONFIG_PATH" \
    grpo.max_num_steps="$MAX_STEPS" \
    logger.log_dir="$LOG_DIR" \
    logger.wandb_enabled=True \
    logger.wandb.project=nemo-rl \
    logger.wandb.name="$EXP_NAME" \
    logger.monitor_gpus=True \
    logger.tensorboard_enabled=True \
    checkpointing.enabled=True \
    checkpointing.checkpoint_dir="$CKPT_DIR" \
    "$@" 2>&1 | tee "$RUN_LOG"
  uv run tests/json_dump_tb_logs.py "$LOG_DIR" --output_path "$JSON_METRICS"
}

check_completed_grpo_run() {
  local metric
  local checks=()
  local required_steps="set(map(str, range(1, $MAX_STEPS + 1)))"
  for metric in train/loss train/grad_norm train/token_mult_prob_error; do
    checks+=("all_finite(data['$metric']) and $required_steps.issubset(data['$metric'])")
  done
  uv run tests/check_metrics.py "$JSON_METRICS" \
    "${checks[@]}" \
    'median(data["train/token_mult_prob_error"]) < 1.1' \
    "data['train/token_mult_prob_error']['$MAX_STEPS'] < 1.1" \
    "$@"
  rm -rf "$CKPT_DIR"
}
