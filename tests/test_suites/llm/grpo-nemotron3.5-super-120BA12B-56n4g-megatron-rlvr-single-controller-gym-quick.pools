# External vLLM judge pools for the test script of the same name. tools/launch sources this file
# (after tools/external_gym_vllm/pool_config.sh) when it submits the heterogeneous job, so it may use
# HF_HOME and GPUS_PER_NODE. Pools fill hetgroup 1: GenRM 2 x TP8 (4 nodes), NL2Bash 2 x TP4
# (2 nodes) and safety 2 x TP4 (2 nodes) = NUM_EXTERNAL_SERVICE_NODES=8.
# Settings follow the super-v3.5-posttraining checkpoint-journey launcher at its smoke shape.

JUDGE_ASSETS_DIR=$HF_HOME/nemotron3.5-super-rlvr
JUDGE_CONTAINER=$JUDGE_ASSETS_DIR/containers/vllm-openai-judges.sqsh
JUDGE_VLLM_PYTHON=/usr/local/bin/python

register_external_vllm_pool GENRM \
  --display-name GenRM \
  --model "$JUDGE_ASSETS_DIR/models/genrm" \
  --container "$JUDGE_CONTAINER" \
  --python "$JUDGE_VLLM_PYTHON" \
  --replicas 2 \
  --tensor-parallel-size 8 \
  --served-model-name model \
  --lb-port 9213 \
  --startup-timeout 3600 \
  --url-placeholder __GENRM_BASE_URL__
external_vllm_pool_env GENRM \
  FLASHINFER_WORKSPACE_BASE=/tmp \
  VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm \
  VLLM_ALLREDUCE_USE_SYMM_MEM=0
external_vllm_pool_args GENRM \
  --trust-remote-code \
  --dtype bfloat16 \
  --kv-cache-dtype fp8 \
  --max-num-seqs 384 \
  --max-model-len 131072 \
  --gpu-memory-utilization 0.95 \
  --enable-prefix-caching \
  --reasoning-parser nemotron_v3 \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_coder \
  --compilation-config '{"pass_config":{"fuse_allreduce_rms":false}}' \
  --model-loader-extra-config '{"enable_multithread_load":true,"num_threads":96}' \
  --enable-expert-parallel

register_external_vllm_pool NL2BASH \
  --display-name NL2Bash \
  --model "$JUDGE_ASSETS_DIR/models/nl2bash-judge" \
  --container "$JUDGE_CONTAINER" \
  --python "$JUDGE_VLLM_PYTHON" \
  --replicas 2 \
  --tensor-parallel-size 4 \
  --served-model-name model \
  --lb-port 9214 \
  --startup-timeout 3600 \
  --url-placeholder __NL2BASH_BASE_URL__
external_vllm_pool_env NL2BASH \
  FLASHINFER_WORKSPACE_BASE=/tmp \
  VLLM_USE_FLASHINFER_MOE_FP16=0 \
  VLLM_USE_FLASHINFER_MOE_FP8=0 \
  VLLM_USE_DEEP_GEMM=0 \
  VLLM_MOE_USE_DEEP_GEMM=0 \
  NCCL_MNNVL_ENABLE=1
external_vllm_pool_args NL2BASH \
  --dtype bfloat16 \
  --pipeline-parallel-size 1 \
  --max-model-len 131072 \
  --max-num-seqs 256 \
  --gpu-memory-utilization 0.85 \
  --enable-prefix-caching \
  --enable-chunked-prefill \
  --enable-auto-tool-choice \
  --tool-call-parser hermes \
  --attention-backend TRITON_ATTN \
  --compilation-config '{"cudagraph_capture_sizes":[1,2,4,8,16,32,64,128,256]}' \
  --model-loader-extra-config '{"enable_multithread_load":true,"num_threads":112}' \
  --enable-expert-parallel

register_external_vllm_pool SAFETY \
  --display-name Safety \
  --model "$JUDGE_ASSETS_DIR/models/safety-judge" \
  --container "$JUDGE_CONTAINER" \
  --python "$JUDGE_VLLM_PYTHON" \
  --replicas 2 \
  --tensor-parallel-size 4 \
  --served-model-name model \
  --lb-port 9215 \
  --startup-timeout 3600 \
  --url-placeholder __SAFETY_BASE_URL__
external_vllm_pool_env SAFETY \
  VLLM_RAY_DP_PACK_STRATEGY=strict \
  VLLM_USE_FASTOKENS=0
external_vllm_pool_args SAFETY \
  --trust-remote-code \
  --dtype bfloat16 \
  --max-model-len 96000 \
  --max-num-seqs 256 \
  --gpu-memory-utilization 0.85 \
  --attention-backend TRITON_ATTN \
  --compilation-config '{"cudagraph_capture_sizes":[1,2,4,8,16]}' \
  --model-loader-extra-config '{"enable_multithread_load":true,"num_threads":16}'

# Point the recipe's judge blocks at the pools' load balancers.
EXTERNAL_VLLM_SCRIPT_ARGS="\
++env.nemo_gym.genrm_model.responses_api_models.genrm_model.base_url=__GENRM_BASE_URL__ \
++env.nemo_gym.nl2bash_judge_model.responses_api_models.local_vllm_model.base_url=__NL2BASH_BASE_URL__ \
++env.nemo_gym.safety_judge_model.responses_api_models.local_vllm_model.base_url=__SAFETY_BASE_URL__"
