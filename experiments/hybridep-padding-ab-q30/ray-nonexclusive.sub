set -euo pipefail

: "${SOURCE_PATH:?SOURCE_PATH must identify the frozen NeMo-RL checkout}"
[[ -f "$SOURCE_PATH/ray.sub" ]] || {
  printf 'ERROR: ray.sub is missing from SOURCE_PATH: %s\n' "$SOURCE_PATH" >&2
  exit 1
}
export NRL_MATRIX_JOB_ID=${SLURM_JOB_ID:?SLURM_JOB_ID is required}

if [[ -z "${CPUS_PER_WORKER:-}" ]]; then
  ALLOCATED_CPUS=${SLURM_CPUS_ON_NODE:?SLURM_CPUS_ON_NODE is required}
  ALLOCATED_CPUS=${ALLOCATED_CPUS%%(*}
  [[ "$ALLOCATED_CPUS" =~ ^[1-9][0-9]*$ ]] || {
    printf 'ERROR: invalid SLURM_CPUS_ON_NODE: %s\n' "$SLURM_CPUS_ON_NODE" >&2
    exit 1
  }
  export CPUS_PER_WORKER=$ALLOCATED_CPUS
fi

exec bash "$SOURCE_PATH/ray.sub"
