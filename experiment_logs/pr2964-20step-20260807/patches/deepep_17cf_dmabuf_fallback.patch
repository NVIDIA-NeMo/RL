--- /dev/null
+++ b/tests/test_hybrid_ep_buffer_init.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: MIT
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved
+
+"""Multi-node HybridEP buffer-construction regression test.
+
+Launch this module with one process per GPU. The test intentionally requires
+more ranks than the configured NVLink domain so it exercises inter-node GPU
+memory registration rather than only the intra-node transport.
+"""
+
+import os
+
+import torch
+import torch.distributed as dist
+
+
+def _required_int(name: str) -> int:
+    return int(os.environ[name])
+
+
+def main() -> None:
+    rank = _required_int("SLURM_PROCID")
+    local_rank = _required_int("SLURM_LOCALID")
+    world_size = _required_int("SLURM_NTASKS")
+    ranks_per_nvlink_domain = _required_int(
+        "NUM_OF_HYBRID_EP_RANKS_PER_NVLINK_DOMAIN"
+    )
+    if world_size <= ranks_per_nvlink_domain:
+        raise RuntimeError(
+            "This regression test requires an inter-node HybridEP group: "
+            f"world_size={world_size}, ranks_per_nvlink_domain="
+            f"{ranks_per_nvlink_domain}"
+        )
+
+    visible_devices = torch.cuda.device_count()
+    device_index = 0 if visible_devices == 1 else local_rank
+    torch.cuda.set_device(device_index)
+    dist.init_process_group(backend="nccl", rank=rank, world_size=world_size)
+
+    from deep_ep import HybridEPBuffer
+
+    buffer = HybridEPBuffer(
+        group=dist.group.WORLD,
+        hidden_dim=4096,
+        max_num_of_tokens_per_rank=2048,
+        num_local_experts=16,
+        use_fp8=False,
+        num_sms_dispatch_api=32,
+        num_sms_combine_api=32,
+    )
+    dist.barrier()
+    if rank == 0:
+        print("hybridep-inter-node-buffer-init: PASS", flush=True)
+    del buffer
+    dist.barrier()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
