+struct ibv_mr *RDMACoordinator::register_gpu_memory(
+    void *address, size_t length, const char *label) {
+  errno = 0;
+  struct ibv_mr *mr = ibv_reg_mr(ib_pd, address, length, mr_access_flag);
+  if (mr != nullptr) {
+    return mr;
+  }
+
+  const int legacy_errno = errno;
+  if (!gpu_handler->support_dmabuf) {
+    std::ostringstream message;
+    message << "HybridEP failed to register " << label << " at " << address
+            << " (length=" << length << ") with ibv_reg_mr: errno="
+            << legacy_errno << " (" << std::strerror(legacy_errno)
+            << "); CUDA DMA-BUF is not supported";
+    throw std::runtime_error(message.str());
+  }
+
+  const auto iova = reinterpret_cast<uintptr_t>(address);
+  CUdeviceptr allocation_base = 0;
+  size_t allocation_size = 0;
+  const CUresult range_result = cuMemGetAddressRange(
+      &allocation_base, &allocation_size, static_cast<CUdeviceptr>(iova));
+  if (range_result != CUDA_SUCCESS) {
+    const char *cuda_error = nullptr;
+    cuGetErrorString(range_result, &cuda_error);
+    std::ostringstream message;
+    message << "HybridEP failed to query the CUDA allocation for " << label
+            << " after ibv_reg_mr returned errno=" << legacy_errno
+            << ": CUDA error=" << range_result << " ("
+            << (cuda_error == nullptr ? "unknown" : cuda_error) << ")";
+    throw std::runtime_error(message.str());
+  }
+  if (allocation_base != static_cast<CUdeviceptr>(iova) ||
+      length > allocation_size) {
+    std::ostringstream message;
+    message << "HybridEP requires a base CUDA allocation for DMA-BUF "
+            << "registration: label=" << label << ", requested=" << address
+            << "/" << length << ", allocation="
+            << reinterpret_cast<void *>(allocation_base) << "/"
+            << allocation_size;
+    throw std::runtime_error(message.str());
+  }
+
+  const long host_page_size = sysconf(_SC_PAGESIZE);
+  if (host_page_size <= 0) {
+    throw std::runtime_error("HybridEP failed to query the host page size");
+  }
+  const auto page_size = static_cast<size_t>(host_page_size);
+  const auto aligned_address = iova & ~(page_size - 1);
+  const auto dmabuf_offset = iova - aligned_address;
+  const size_t dmabuf_length =
+      (length + dmabuf_offset + page_size - 1) & ~(page_size - 1);
+
+  int dmabuf_fd = -1;
+  const CUresult export_result = cuMemGetHandleForAddressRange(
+      &dmabuf_fd,
+      static_cast<CUdeviceptr>(aligned_address),
+      dmabuf_length,
+      CU_MEM_RANGE_HANDLE_TYPE_DMA_BUF_FD,
+      0);
+  if (export_result != CUDA_SUCCESS) {
+    const char *cuda_error = nullptr;
+    cuGetErrorString(export_result, &cuda_error);
+    std::ostringstream message;
+    message << "HybridEP failed to export " << label
+            << " as CUDA DMA-BUF after ibv_reg_mr returned errno="
+            << legacy_errno << ": CUDA error=" << export_result << " ("
+            << (cuda_error == nullptr ? "unknown" : cuda_error) << ")";
+    throw std::runtime_error(message.str());
+  }
+
+  errno = 0;
+  mr = ibv_reg_dmabuf_mr(
+      ib_pd,
+      0,
+      dmabuf_length,
+      aligned_address,
+      dmabuf_fd,
+      mr_access_flag);
+  const int dmabuf_errno = errno;
+  close(dmabuf_fd);
+
+  if (mr == nullptr) {
+    std::ostringstream message;
+    message << "HybridEP failed to register " << label
+            << " through both GPUDirect RDMA paths: ibv_reg_mr errno="
+            << legacy_errno << " (" << std::strerror(legacy_errno)
+            << "), ibv_reg_dmabuf_mr errno=" << dmabuf_errno << " ("
+            << std::strerror(dmabuf_errno) << ")";
+    throw std::runtime_error(message.str());
+  }
+
+  if (!dmabuf_fallback_logged) {
+    fprintf(
+        stderr,
+        "[HybridEP] ibv_reg_mr failed with errno=%d; using CUDA DMA-BUF "
+        "registration fallback (rank=%d, local_rank=%d, label=%s, "
+        "requested=%p/%zu, allocation=%p/%zu, registered_iova=%p/%zu, "
+        "mr_addr=%p)\n",
+        legacy_errno,
+        node_rank * buffer_config.num_of_ranks_per_node + local_rank,
+        local_rank,
+        label,
+        address,
+        length,
+        reinterpret_cast<void *>(allocation_base),
+        allocation_size,
+        reinterpret_cast<void *>(aligned_address),
+        dmabuf_length,
+        mr->addr);
+    dmabuf_fallback_logged = true;
+  }
+  return mr;
+}
