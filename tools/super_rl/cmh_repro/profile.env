# Fixed CMH ARM runtime contract; user paths are supplied separately.
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export PYTHONPATH=/opt/nemo-rl:/opt/nemo-rl/3rdparty/Gym-workspace/Gym
export NEMO_GYM_EXTRA_ROOTS=/opt/nemo-rl/3rdparty/Gym-workspace/Gym
export NRL_IGNORE_VERSION_MISMATCH=1 NRL_FORCE_REBUILD_VENVS=false
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_MODULES_CACHE=/tmp/nemo_rl_hf_modules
export CUDA_DEVICE_MAX_CONNECTIONS=1 VLLM_USE_PRECOMPILED=1 VLLM_USE_DEEP_GEMM=0 NCCL_MNNVL_ENABLE=0
export NRL_VLLM_USE_V1=1 NRL_VLLM_ASYNC_TIMEOUT_SECONDS=7200 NRL_WG_USE_RAY_REF=1
export NEMO_GYM_VENV_DIR=/opt/train_gym_venvs RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
export NRL_ROUTER_REPLAY_EXCLUDE_MTP=1 NRL_ROUTER_REPLAY_VALIDATE=1
export NRL_R3_TRACE=0 NRL_R3_TRACE_VERIFY_FORWARD=0 R3_TRANSITION_FROM_LEGACY=false RAY_SUB_DEBUG_ENV=0
export SUPER_RL_CONFIG=/opt/nemo-rl/training_configs/super_rl/experiments/regular_s120_cmh_fullscale.yaml
export HF_HOME="$SUPER_RL_ROOT/hf-home"
export NRL_MEGATRON_CHECKPOINT_DIR="$SUPER_RL_ROOT/initial-model-import-cache"
