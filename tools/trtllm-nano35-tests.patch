+def test_populate_req_stats_excludes_special_queue_items(special_item: RequestQueueItem) -> None:
+    """Control/cancel messages must not become inference request statistics."""
+    request_queue = ExecutorRequestQueue(
+        dist=Mock(), max_batch_size=8, enable_iter_perf_stats=False, batch_wait_timeout_ms=0
+    )
+    queue = request_queue.get_request_queue()
+    queue.put(RequestQueueItem(0, Mock()))
+    queue.put(special_item)
+    queue.put(RequestQueueItem(7, Mock()))
+    queue.put(RequestQueueItem(2**64 - 1, Mock()))
+    executor = types.SimpleNamespace(executor_request_queue=request_queue)
+
+    stats = PyExecutor._populate_req_stats(executor, [], [], ScheduledRequests())
+
+    assert [stat.id for stat in stats] == [0, 7, 2**64 - 1]
+    assert all(stat.stage == RequestStage.QUEUED for stat in stats)
+    assert all(stat.num_generated_tokens == 0 for stat in stats)
+    assert list(queue.queue)[1] is special_item
+
