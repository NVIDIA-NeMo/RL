+"""Log NIXL incident context and stop the current Slurm allocation."""
+
+import json
+import logging
+import os
+import shutil
+import socket
+import subprocess
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from typing import Any
+
+logger = logging.getLogger(__name__)
+DEFAULT_KV_FAILURE_ACTION = "stop_job"
+
+
+def node_name() -> str:
+    """Return the worker's actual hostname."""
+    return socket.gethostname()
+
+
+@dataclass(frozen=True)
+class KVFailurePolicy:
+    """Validated response to KV transport, expiry, and verification failures."""
+
+    action: str
+    job_id: str | None = None
+    cancel_command: str | None = None
+
+    @classmethod
+    def create(
+        cls,
+        action: str,
+        *,
+        load_failure_policy: str,
+        lease_verification: bool,
+    ) -> "KVFailurePolicy":
+        """Reject an unusable fail-stop deployment before registering KV."""
+        if action not in ("stop_job", "fail_request"):
+            raise ValueError("kv_failure_action must be stop_job or fail_request")
+        if action == "fail_request":
+            return cls(action)
+        if load_failure_policy != "fail" or not lease_verification:
+            raise ValueError(
+                "stop_job requires kv_load_failure_policy=fail and "
+                "kv_lease_verification=true; use kv_failure_action=fail_request "
+                "only for request-level diagnostics"
+            )
+        job_id = os.environ.get("SLURM_JOB_ID", "")
+        if not job_id or not job_id.isascii() or not job_id.isdigit():
+            raise ValueError("stop_job requires the current numeric SLURM_JOB_ID")
+        cancel_command = shutil.which("scancel")
+        if cancel_command is None:
+            raise ValueError(
+                "stop_job requires scancel in every P/D worker environment; "
+                "make the Slurm client available before starting workers"
+            )
+        return cls(action, job_id, cancel_command)
+
+    def on_failure(self, *, reason: str, context: dict[str, Any]) -> None:
+        """Flush a node report before cancelling this allocation and raising."""
+        if self.action == "fail_request":
+            return
+        report = {
+            **context,
+            "event": "nixl_job_stop_requested",
+            "time_utc": datetime.now(UTC).isoformat(),
+            "slurm_job_id": self.job_id,
+            "allocation_nodes": os.environ.get("SLURM_JOB_NODELIST"),
+            "local_node": node_name(),
+            "slurm_node": os.environ.get("SLURMD_NODENAME"),
+            "reason": reason,
+        }
+        message = (
+            "NIXL fail-stop: please report to AGA support team "
+            "(#oci-aga-slurm-1-support) with this node report and preceding "
+            "NIXL error logs. Cluster support should assess the reported endpoints. "
+            + json.dumps(report, sort_keys=True)
+        )
+        logger.critical("%s", message)
+        assert self.cancel_command is not None and self.job_id is not None
+        try:
+            subprocess.run(
+                [self.cancel_command, self.job_id],
+                check=True,
+                capture_output=True,
+                text=True,
+                timeout=10,
+            )
+        except (OSError, subprocess.SubprocessError) as error:
+            logger.critical(
+                "scancel failed for job %s: %s; terminate this allocation manually",
+                self.job_id,
+                error,
+            )
+            raise RuntimeError(
+                message + "; scancel failed; terminate this allocation manually"
+            ) from error
+        raise RuntimeError(message + "; allocation cancellation requested")
