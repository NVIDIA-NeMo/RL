# Copy outside Git. Paths must be absolute, on CMH /scratch, without whitespace or commas.
# Obtain the exact source dependencies and image described in the reproduction guide.
export SUPER_RL_ROOT=/scratch/REPLACE_ME/new_unique_run
export SUPER_RL_MODEL=/scratch/REPLACE_ME/s120/hf
export SUPER_RL_DATA=/scratch/REPLACE_ME/train.jsonl
export SUPER_RL_DATA_SHA256=REPLACE_ME
export SUPER_RL_SCICODE_HDF5=/scratch/REPLACE_ME/combined_test_data.h5
export SUPER_RL_PARSER=/scratch/REPLACE_ME/ultra_v3_reasoning_parser.py
export SUPER_RL_TRAIN_IMAGE=/scratch/REPLACE_ME/training.squashfs
export SUPER_RL_WHEEL=/scratch/REPLACE_ME/openai-2.25.0-py3-none-any.whl
# Private mode-600 file OUTSIDE the run root; exports NVIDIA_API_KEY and WANDB_API_KEY.
# Never put key values in this config or Git.
export SUPER_RL_SECRET_FILE=/scratch/REPLACE_ME/private/training.env
export SUPER_RL_ACCOUNT=REPLACE_ME
export SUPER_RL_RUN_NAME=REPLACE_ME
export WANDB_ENTITY=REPLACE_ME
export WANDB_PROJECT=REPLACE_ME
export WANDB_RUN_ID=REPLACE_ME
# Reproduces the reviewed long allocation, NOT a guarantee against preemption.
export SUPER_RL_PARTITION=batch_long
export SUPER_RL_QOS=normal
export SUPER_RL_WALLTIME=2-00:00:00
export SUPER_RL_SAFE_DEADLINE=01:23:00:00
export SUPER_RL_CPU_PARTITION=cpu
export SUPER_RL_CPU_QOS=cpu-short
