[submodule "3rdparty/Megatron-Bridge"]
	path = 3rdparty/Megatron-Bridge-workspace/Megatron-Bridge
	url = https://github.com/NVIDIA-NeMo/Megatron-Bridge.git
	branch = main
	shallow = true
[submodule "3rdparty/Automodel-workspace/Automodel"]
	path = 3rdparty/Automodel-workspace/Automodel
	# Muse Glimmer support, tracked on the author's branch rather than an r0.6.0
	# rebase: 90da1dec aligns Onyx (the architecture backing Muse Glimmer) with
	# the final transformers implementation, which uses split-half RoPE instead
	# of adjacent-pair. The released Muse Glimmer checkpoint requires it.
	# Every nemo_automodel symbol NeMo-RL imports resolves on this base, and its
	# distributed/ layer already carries MeshContext + DistributedSetup.
	#
	# Points at the author's repo, which is where huiyingl/feat/onyx-training and
	# 90da1dec actually live. SSH because the repo is private -- cloning this
	# submodule requires access to it.
	#
	# shallow is off: a --depth 1 clone of the branch head cannot serve an older
	# pinned commit, and `git submodule update --init` then fails with
	# "upload-pack: not our ref".
	#
	# TODO: repoint at https://github.com/NVIDIA-NeMo/Automodel.git once Muse
	# Glimmer support lands there; this pin blocks a public upstream PR.
	url = git@github.com:HuiyingLi/Automodel-day0.git
	branch = huiyingl/feat/onyx-training
[submodule "3rdparty/Gym-workspace/Gym"]
	path = 3rdparty/Gym-workspace/Gym
	url = https://github.com/NVIDIA-NeMo/Gym.git
	branch = main
	shallow = true
